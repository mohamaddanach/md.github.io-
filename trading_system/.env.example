# Copy this file to .env (same folder as main.py) and fill in your values.
# .env is git-ignored. NEVER commit your real token.

# From @BotFather. If a token was ever pasted in chat or code, revoke it (/revoke) and use a new one.
TELEGRAM_TOKEN=

# Comma-separated chat ids allowed to control the bot. Send /myid to the bot to get yours.
TELEGRAM_ALLOWED_CHAT_IDS=

DEFAULT_SYMBOL=EURUSD
# Leave empty to auto-detect C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=
LOT_SIZE=0.01
MAX_OPEN_POSITIONS=3
HISTORY_BARS=30000
CLASSIC_SL_PIPS=15
CLASSIC_TP_PIPS=30
MONITOR_INTERVAL_SEC=3

# Manual trading (/buy /sell) defaults and safety limit
MANUAL_SL_PIPS=20
MANUAL_TP_PIPS=40
MANUAL_MAX_LOT=1.0
# How often (seconds) automatic mode checks for a new candle
AUTO_CHECK_INTERVAL_SEC=20
