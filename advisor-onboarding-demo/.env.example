# --- AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Database (use the service-role key; it never leaves the server) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Security ---
# Comma-separated. Use your real portal domain(s) in production.
ALLOWED_ORIGINS=http://localhost:5173
# Required for /advisors/{id}/webhook admin endpoints (send as X-Admin-Key header)
ADMIN_API_KEY=change-me
# Dev only: allow http:// and localhost webhook targets
ALLOW_INSECURE_WEBHOOKS=false

# --- Portal ---
PORTAL_BASE_URL=http://localhost:5173
MAX_UPLOAD_MB=15
CONFIDENCE_THRESHOLD=0.80

# --- Demo tenant (/onboard/demo) — works even before the advisors table exists ---
DEMO_ADVISOR_ID=demo
DEMO_FIRM_NAME=Summit Ridge Wealth Partners
DEMO_WEBHOOK_URL=
DEMO_WEBHOOK_SECRET=
# on_extract = push to CRM immediately; on_approve = wait for advisor review (Task 3)
WEBHOOK_DISPATCH_MODE=on_extract
